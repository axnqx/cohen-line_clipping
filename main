"""Cohen-Sutherland line clipping for M.Sc. Computer Science Graphics Lab.

Roll number: 208
Second-last digit (a): 0
Last digit (b): 8
Personalized line L6: (40 + a, 20) to (190 - b, 180)
                   = (40, 20) to (182, 180)

Region-code bit order: TOP, BOTTOM, RIGHT, LEFT.
"""

import matplotlib.pyplot as plt
from matplotlib.patches import Rectangle

# Clipping window
X_MIN, Y_MIN = 50, 50
X_MAX, Y_MAX = 200, 150

# Region-code bits in the order required by the assignment.
TOP = 0b1000
BOTTOM = 0b0100
RIGHT = 0b0010
LEFT = 0b0001


def region_code(x, y):
    """Return the 4-bit Cohen-Sutherland region code for point (x, y)."""
    code = 0

    if y > Y_MAX:
        code |= TOP
    if y < Y_MIN:
        code |= BOTTOM
    if x > X_MAX:
        code |= RIGHT
    if x < X_MIN:
        code |= LEFT

    return code


def find_intersection(x1, y1, x2, y2, out_code):
    """Find the intersection of the line with one boundary indicated by out_code."""
    dx = x2 - x1
    dy = y2 - y1

    # Boundary priority follows TOP, BOTTOM, RIGHT, LEFT.
    if out_code & TOP:
        if dy == 0:
            return None
        x = x1 + dx * (Y_MAX - y1) / dy
        y = Y_MAX
    elif out_code & BOTTOM:
        if dy == 0:
            return None
        x = x1 + dx * (Y_MIN - y1) / dy
        y = Y_MIN
    elif out_code & RIGHT:
        if dx == 0:
            return None
        y = y1 + dy * (X_MAX - x1) / dx
        x = X_MAX
    elif out_code & LEFT:
        if dx == 0:
            return None
        y = y1 + dy * (X_MIN - x1) / dx
        x = X_MIN
    else:
        return None

    return x, y


def cohen_sutherland_clip(p1, p2):
    """Clip a line and return (clipped_p1, clipped_p2, outcome, passes).

    'passes' counts actual intersection calculations. The final trivial
    accept/reject test is not counted as a clipping pass.
    """
    x1, y1 = p1
    x2, y2 = p2
    original_code1 = region_code(x1, y1)
    original_code2 = region_code(x2, y2)
    passes = 0

    while True:
        code1 = region_code(x1, y1)
        code2 = region_code(x2, y2)

        # Trivial accept: both endpoints are inside the clipping window.
        if (code1 | code2) == 0:
            outcome = "accepted" if passes == 0 else "clipped"
            return (x1, y1), (x2, y2), outcome, passes

        # Trivial reject: both endpoints lie outside in a common region.
        if (code1 & code2) != 0:
            return None, None, "rejected", passes

        # Neither trivial test applies. Clip one outside endpoint.
        outside_code = code1 if code1 != 0 else code2
        intersection = find_intersection(x1, y1, x2, y2, outside_code)

        # This is a defensive guard for a degenerate parallel-line case.
        if intersection is None:
            return None, None, "rejected", passes

        passes += 1

        if outside_code == code1:
            x1, y1 = intersection
        else:
            x2, y2 = intersection


# Fixed lines from the assignment. L6 is personalized for roll number 208.
A = 0  # second-last digit of 208
B = 8  # last digit of 208

LINES = {
    "L1": ((140, 70), (185, 130)),
    "L2": ((10, 165), (40, 190)),
    "L3": ((20, 125), (250, 125)),
    "L4": ((80, 20), (80, 180)),
    "L5": ((20, 20), (150, 200)),
    "L6": ((40 + A, 20), (190 - B, 180)),
}


def format_point(point):
    """Format a point to three decimal places."""
    if point is None:
        return "-"
    return f"({point[0]:.3f}, {point[1]:.3f})"


def print_result_table(results):
    """Print the original endpoints, codes, outcome, passes and clipped line."""
    headers = [
        "Line", "From", "To", "Code 1", "Code 2",
        "Outcome", "Loop runs*", "Clipped from", "Clipped to"
    ]
    rows = []

    for name, p1, p2, c1, c2, q1, q2, outcome, passes in results:
        rows.append([
            name,
            format_point(p1),
            format_point(p2),
            f"{c1:04b}",
            f"{c2:04b}",
            outcome,
            str(passes),
            format_point(q1),
            format_point(q2),
        ])

    widths = [max(len(headers[i]), *(len(row[i]) for row in rows)) for i in range(len(headers))]
    separator = "+-" + "-+-".join("-" * width for width in widths) + "-+"

    print("\nCOHEN-SUTHERLAND LINE CLIPPING — ROLL NO. 208")
    print(f"Window: ({X_MIN}, {Y_MIN}) to ({X_MAX}, {Y_MAX})")
    print(f"a = {A}, b = {B}, L6 = {LINES['L6'][0]} to {LINES['L6'][1]}")
    print(separator)
    print("| " + " | ".join(headers[i].ljust(widths[i]) for i in range(len(headers))) + " |")
    print(separator)
    for row in rows:
        print("| " + " | ".join(row[i].ljust(widths[i]) for i in range(len(row))) + " |")
    print(separator)
    print("* Loop runs counts intersection/clipping passes; the final accept/reject test is not counted.\n")


def draw_figure(results, output_file="clipping_208.png"):
    """Draw input lines dashed and surviving clipped portions as thick solids."""
    fig, ax = plt.subplots(figsize=(9, 7))

    # Draw the rectangular clipping window.
    window = Rectangle(
        (X_MIN, Y_MIN), X_MAX - X_MIN, Y_MAX - Y_MIN,
        fill=False, edgecolor="black", linewidth=2.0, label="Clipping window"
    )
    ax.add_patch(window)

    # Draw all six original lines as dashed lines and their surviving portions.
    for name, p1, p2, _c1, _c2, q1, q2, outcome, _passes in results:
        ax.plot(
            [p1[0], p2[0]], [p1[1], p2[1]],
            linestyle="--", linewidth=1.2, alpha=0.75, label=f"{name} input"
        )
        if outcome != "rejected" and q1 is not None and q2 is not None:
            ax.plot(
                [q1[0], q2[0]], [q1[1], q2[1]],
                linestyle="-", linewidth=3.2, label=f"{name} clipped"
            )

    ax.set_xlim(0, 270)
    ax.set_ylim(0, 220)
    ax.set_xlabel("X")
    ax.set_ylabel("Y")
    ax.set_title("Cohen-Sutherland Line Clipping — Roll No. 208")
    ax.set_aspect("equal", adjustable="box")  # 1:1 aspect ratio
    ax.grid(True, linestyle=":", linewidth=0.6, alpha=0.6)
    ax.legend(loc="upper left", bbox_to_anchor=(1.02, 1), fontsize=8)
    fig.tight_layout()
    fig.savefig(output_file, dpi=200, bbox_inches="tight")
    print(f"Figure saved as: {output_file}")
    plt.show()


def main():
    results = []

    for name, (p1, p2) in LINES.items():
        code1 = region_code(*p1)
        code2 = region_code(*p2)
        q1, q2, outcome, passes = cohen_sutherland_clip(p1, p2)
        results.append((name, p1, p2, code1, code2, q1, q2, outcome, passes))

    print_result_table(results)
    draw_figure(results)


if __name__ == "__main__":
    main()














